# Persistence. Leave blank to run the file-backed store under .data, which needs
# no accounts and survives a restart. When both are set the Supabase adapter
# takes over automatically.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Newspaper prose. Leave blank for the deterministic writer.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RAG_PROVIDER=

# Turn timing
TICK_SECRET=dev-tick-secret
TICK_INTERVAL_HOURS=24
TICK_DEV_MODE=true
